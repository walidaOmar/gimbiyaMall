# Local Development Environment
# ⚠️ NEVER commit real credentials to git. Use .env.example as template.

# Database - Replace with your MongoDB connection string
MONGODB_URI=mongodb+srv://admin:gimbiya123@gimbiya-cluster.7wtqk.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=gimbiya_mall

# Server
NODE_ENV=development
PORT=3000

# CORS - Local development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT - Use a strong, random key (min 32 characters)
JWT_SECRET=dev-secret-key-change-in-production-12345678

# Monnify (Test credentials - update with real values for production)
MONNIFY_API_KEY=MK_TEST_123456789
MONNIFY_SECRET_KEY=SK_TEST_123456789
MONNIFY_CONTRACT_CODE=TEST_CODEb

# Firebase (Optional for dev - can be added later)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email

# LLM & Voiceover (Optional for dev - can be added later)
