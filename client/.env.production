# Production API endpoint — use a RELATIVE URL so requests go through
# Netlify's proxy and avoid CORS preflight. Do NOT put the full Railway
# URL here; keep it as /api/trpc so frontend requests remain same-origin.
VITE_API_URL=/api/trpc

# Firebase Configuration (get from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
