# Production API endpoint - set via Netlify environment variables
# Replace with your actual Render backend URL (e.g., https://gimbiya-mall-backend.onrender.com)
# This will be set in Netlify's Environment settings under Build & deploy > Environment
VITE_API_URL=https://your-render-backend-url.onrender.com

# Firebase Configuration (get from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
